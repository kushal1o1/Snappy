{
  "manifest_version": 3,
  "name": "Snappy",
  "version": "1.0.0",
  "description": "Capture and restore tab snapshots",
  "permissions": ["tabs", "windows", "sidePanel", "storage"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Snappy"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}